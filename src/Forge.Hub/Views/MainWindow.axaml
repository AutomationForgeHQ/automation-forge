<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Forge.Hub.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="Forge.Hub.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1180" Height="760" MinWidth="760" MinHeight="480"
        Background="{StaticResource InkBrush}"
        Icon="/Assets/forge.ico"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="Automation Forge">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Our chrome: the drag strip and the caption buttons -->
    <Border Grid.Row="0" Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
            PointerPressed="TitleBar_PointerPressed">
      <Grid ColumnDefinitions="*,Auto" Height="38">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
          <Path Data="M 6.5 0 L 13 11.5 L 0 11.5 Z" Stroke="{StaticResource AmberBrush}" StrokeThickness="1.3" Fill="Transparent" Width="13" Height="12" VerticalAlignment="Center" />
          <TextBlock Classes="stamp" Text="Automation Forge" Foreground="{StaticResource BoneBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="stamp" Text="{Binding HubVersion}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="caption" Click="Minimize_Click" ToolTip.Tip="Minimise">
            <Path Data="M 0 5 H 10" Stroke="{StaticResource BoneBrush}" Opacity="0.75" StrokeThickness="1" Width="10" Height="10" />
          </Button>
          <Button Classes="caption" Click="Maximize_Click" ToolTip.Tip="Maximise">
            <Path Data="M 0.5 0.5 H 9.5 V 9.5 H 0.5 Z" Stroke="{StaticResource BoneBrush}" Opacity="0.75" StrokeThickness="1" Fill="Transparent" Width="10" Height="10" />
          </Button>
          <Button Classes="caption close" Click="Close_Click" ToolTip.Tip="Close">
            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{StaticResource BoneBrush}" Opacity="0.75" StrokeThickness="1" Width="10" Height="10" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Header -->
    <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,18,28,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Spacing="8" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="22">
            <Button Classes="tab" Classes.selected="{Binding IsPluginsTab}" Content="Plugins" Command="{Binding ShowPluginsCommand}" />
            <Button Classes="tab" Classes.selected="{Binding IsRunnersShown}" Content="Runners" Command="{Binding ShowRunnersCommand}" />
          </StackPanel>
          <TextBlock Classes="stamp" Text="{Binding SourceStamp}" Foreground="{StaticResource BoneBrush}" IsVisible="{Binding IsPluginsTab}" />
          <TextBlock Classes="stamp" Text="What this machine can run, and what it is doing" IsVisible="{Binding IsRunnersShown}" />
          <TextBlock Classes="stamp" Text="{Binding KeysLine}" IsVisible="{Binding IsKeysPage}" />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" ItemSpacing="10" LineSpacing="8">
          <ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}" MinWidth="200" MaxWidth="380" VerticalAlignment="Center"
                    IsVisible="{Binding IsPluginsTab}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:Object">
                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="ghost" Content="Refresh" Command="{Binding RefreshCommand}" />
          <Button Classes="ghost" Classes.selected="{Binding IsKeysPage}" Content="Keys" Command="{Binding ShowKeysCommand}" />
          <Button Classes="ghost" Content="Settings" Command="{Binding ToggleSettingsCommand}" />
          <Button Classes="primary" Content="Sign in" Command="{Binding SignInCommand}" IsVisible="{Binding !IsSignedIn}" />
          <!-- Signed in: the avatar, and a small menu under it. -->
          <Button Classes="avatar" IsVisible="{Binding IsSignedIn}" ToolTip.Tip="{Binding AccountEmail}" AutomationProperties.Name="Account menu">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Account" Command="{Binding OpenAccountCommand}" />
                <MenuItem Header="Sign out" Command="{Binding SignOutCommand}" />
              </MenuFlyout>
            </Button.Flyout>
            <Panel Width="34" Height="34">
              <Ellipse Classes="ring" Fill="{StaticResource PlateBrush}" Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1" />
              <Ellipse IsVisible="{Binding HasAvatar}">
                <Ellipse.Fill>
                  <ImageBrush Source="{Binding Avatar}" Stretch="UniformToFill" />
                </Ellipse.Fill>
              </Ellipse>
              <Path IsVisible="{Binding !HasAvatar}" Data="M 7.5 8.5 A 4.5 4.5 0 1 1 16.5 8.5 A 4.5 4.5 0 1 1 7.5 8.5 M 3.5 23 C 3.5 18.5 7.3 15.5 12 15.5 C 16.7 15.5 20.5 18.5 20.5 23" Stroke="{StaticResource MuteBrush}" StrokeThickness="1.4" Fill="Transparent" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Button>
        </WrapPanel>
        <Panel />
      </DockPanel>
    </Border>

    <!-- Body: sets on the left, the selected set on the right; settings slide over from the right -->
    <Panel Grid.Row="2">
      <Grid ColumnDefinitions="248,*" IsVisible="{Binding IsPluginsTab}">

        <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Background="{StaticResource PlateBrush}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="20,12,20,18" Spacing="10">
              <TextBlock Classes="stamp" IsVisible="{Binding HasUpdates}" Text="{Binding UpdatesLabel}" Foreground="{StaticResource AmberBrush}" />
              <Button Classes="primary" Content="Update all" Command="{Binding UpdateAllCommand}" IsVisible="{Binding HasUpdates}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <TextBlock Classes="stamp" Text="Free on your own hardware. Open where it counts." TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Classes="label" Text="SETS" Margin="20,18,20,8" />
            <ListBox ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}" Background="Transparent" BorderThickness="0" Padding="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SetGroup">
                  <Grid ColumnDefinitions="*,Auto" Margin="20,10,16,10">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="display" Text="{Binding Name}" FontSize="14" />
                      <TextBlock Classes="stamp" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" IsVisible="{Binding HasUpdates}" Background="{StaticResource AmberBrush}" CornerRadius="9" MinWidth="18" Height="18" VerticalAlignment="Center" Padding="6,0">
                      <TextBlock Text="{Binding UpdateCount}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="32,26,32,20" HorizontalScrollBarVisibility="Disabled">
          <StackPanel DataContext="{Binding SelectedSet}" x:DataType="vm:SetGroup">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="display" Text="{Binding Name}" FontSize="30" />
                <TextBlock Classes="stamp" Text="{Binding Summary}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Content="Install set" Command="{Binding InstallSetCommand}" IsEnabled="{Binding CanInstallSet}" VerticalAlignment="Center" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Plugins}" Margin="0,22,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PluginRow">
                  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,14">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20">
                      <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="display" Text="{Binding Id}" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="stamp" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" MinWidth="170">
                        <TextBlock Classes="mono" Text="{Binding VersionLine}" />
                        <TextBlock Classes="stamp" Text="{Binding Status}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="ghost" Content="Remove" Command="{Binding UninstallCommand}" IsVisible="{Binding CanUninstall}" />
                        <Button Classes="primary" Content="{Binding ActionLabel}" Command="{Binding ActCommand}" MinWidth="92" HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Runners: what this machine can run. Docker and a rented GPU are outside Unreal, so the
           hub can see and drive them without an editor open — which is the point, since starting the
           runner is a thing you do before opening one. -->
      <ScrollViewer IsVisible="{Binding IsRunnersShown}" Padding="32,26,32,20" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">

          <TextBlock Classes="label" Text="THIS MACHINE" IsVisible="{Binding HasRunners}" />

          <StackPanel Spacing="6" IsVisible="{Binding !HasRunners}">
            <TextBlock Classes="display" Text="Nothing to run" FontSize="22" />
            <TextBlock Classes="stamp" TextWrapping="Wrap"
                       Text="No installed plugin manages something that runs on this machine. MotionForge Kimodo is the one that does today — a local Docker container, or a GPU rented by the hour." />
            <TextBlock Classes="stamp" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Only plugins installed into an engine appear here. A plugin added to a single project is set up inside that project's editor." />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Runners}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RunnerRow">
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource PlateBrush}" Padding="22,18" Margin="0,0,0,14">
                  <StackPanel Spacing="14">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                               Fill="{StaticResource MuteBrush}" />
                      <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                               IsVisible="{Binding IsRunning}" Fill="#4CC76F" />
                      <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                               IsVisible="{Binding NeedsAttention}" Fill="{StaticResource AmberBrush}" />

                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Classes="display" Text="{Binding Title}" FontSize="17" />
                        <TextBlock Classes="stamp" Text="{Binding Plugin}" />
                      </StackPanel>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="link" Content="Re-check" Command="{Binding RefreshCommand}" />
                        <Button Classes="ghost" Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" />
                        <Button Classes="primary" Content="Start" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" MinWidth="84" HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                      <TextBlock Classes="stamp" Text="Docker" />
                      <TextBlock Grid.Column="1" Classes="stamp" Text="{Binding DockerLine}" Foreground="{StaticResource BoneBrush}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="1" Classes="stamp" Text="Runner" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="stamp" Text="{Binding StateLine}" Foreground="{StaticResource BoneBrush}" TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock Classes="stamp" Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="stamp" IsVisible="{Binding HasRunners}" TextWrapping="Wrap"
                     Text="The editor can drive the same containers, and either can start or stop one while the other is watching — so both ask Docker rather than trusting what they last did." />

          <!-- Rented machines. Read and stop: which card, in which region, under what price ceiling
               is a decision made against what a model needs, so the editor makes it. This is where
               you see what came of it. -->
          <StackPanel Spacing="14" IsVisible="{Binding CanRent}" Margin="0,22,0,0">

            <TextBlock Classes="label" Text="A RENTED GPU" />

            <!-- Never set up, or set up and not answering. Neither is a list of machines, and
                 drawing an empty one would say "nothing rented" about an account nobody asked. -->
            <Border IsVisible="{Binding ShowRentInvitation}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Background="{StaticResource PlateBrush}" Padding="22,18">
              <StackPanel Spacing="12">
                <TextBlock Classes="stamp" Text="{Binding RentInvitationLine}" TextWrapping="Wrap"
                           Foreground="{StaticResource BoneBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="{Binding CloudKeyName, StringFormat='Set the {0} key'}"
                          Command="{Binding ShowKeysCommand}" IsVisible="{Binding !HasCloudKey}" />
                  <Button Classes="ghost" Content="Try again" Command="{Binding RefreshRentedCommand}" IsVisible="{Binding HasCloudKey}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Classes="stamp" Text="{Binding RentedLine}" Foreground="{StaticResource BoneBrush}"
                       TextWrapping="Wrap" IsVisible="{Binding ShowRented}" />

            <ItemsControl ItemsSource="{Binding Rented}" IsVisible="{Binding ShowRented}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RentedRow">
                  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource PlateBrush}" Padding="22,18" Margin="0,0,0,10">
                    <StackPanel Spacing="12">

                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Fill="{StaticResource MuteBrush}" />
                        <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" IsVisible="{Binding IsRunning}" Fill="#4CC76F" />

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Classes="display" Text="{Binding Title}" FontSize="17" />
                          <TextBlock Classes="stamp" Text="{Binding StateLine}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Button Classes="ghost" Content="Start" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" />
                          <Button Classes="ghost" Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}" />
                          <Button Classes="primary" Content="Release" Command="{Binding ReleaseCommand}" MinWidth="86" HorizontalContentAlignment="Center" />
                        </StackPanel>
                      </Grid>

                      <TextBlock Classes="stamp" Text="{Binding CostLine}" TextWrapping="Wrap"
                                 Foreground="{StaticResource AmberBrush}" />

                      <TextBlock Classes="stamp" Text="{Binding Message}" TextWrapping="Wrap"
                                 IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Foreground="{StaticResource BoneBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="stamp" TextWrapping="Wrap"
                       Text="Renting one is done in the editor, where the card, the region and the price ceiling are chosen against what the model needs. Stopping and releasing need none of that, so they are here." />
            <TextBlock Classes="stamp" TextWrapping="Wrap" IsVisible="{Binding ShowRentInvitation}"
                       Text="{Binding CloudPluginName, StringFormat='This is here because {0} is installed. It is the plugin that can rent one.'}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>


      <!-- Keys: its own page, opened from the header. Machine-wide and plugin-dependent, which is
           why the hub holds them at all - but setting one is a thing you do once, so it does not
           get a tab beside the two things you come back to. -->
      <ScrollViewer IsVisible="{Binding IsKeysPage}" Padding="32,26,32,20" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="860" HorizontalAlignment="Left">

          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="link" Content="Close" Command="{Binding CloseKeysCommand}" />
            <StackPanel Spacing="4">
              <TextBlock Classes="display" Text="Keys" FontSize="30" />
              <TextBlock Classes="stamp" TextWrapping="Wrap"
                         Text="One vault, shared with the editor. A key set here is set for every project on this machine." />
            </StackPanel>
          </DockPanel>

          <StackPanel Spacing="8" IsVisible="{Binding !HasKeys}">
            <TextBlock Classes="stamp" TextWrapping="Wrap"
                       Text="No installed plugin is asking for a key." />
            <TextBlock Classes="stamp" TextWrapping="Wrap"
                       Text="Only plugins installed into an engine appear here, and only once they ship a declaration of what they need. A plugin added to a single project is set up inside that project's editor." />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding KeyGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KeyGroup">
                <StackPanel Spacing="10" Margin="0,10,0,18">
                  <TextBlock Classes="label" Text="{Binding Plugin}" Foreground="{StaticResource AmberBrush}" />

                  <ItemsControl ItemsSource="{Binding Keys}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:KeyRow">
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource PlateBrush}" Padding="20,16" Margin="0,0,0,10">
                          <StackPanel Spacing="10">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                              <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource LineStrongBrush}" />
                              <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding IsSet}" Fill="#4CC76F" />
                              <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding IsMissing}" Fill="{StaticResource AmberBrush}" />

                              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Classes="display" FontSize="16" Text="{Binding Title}" />
                                <TextBlock Classes="stamp" Text="{Binding StatusLine}" Foreground="{StaticResource BoneBrush}" />
                              </StackPanel>

                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="link" Content="Where to get one" Command="{Binding HelpCommand}" IsVisible="{Binding HasHelp}" />
                                <Button Classes="ghost" Content="Remove" Command="{Binding ClearCommand}" IsVisible="{Binding CanClear}" />
                              </StackPanel>
                            </Grid>

                            <TextBlock Classes="stamp" Text="{Binding Purpose}" TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBox Grid.Column="0" Text="{Binding Secret, Mode=TwoWay}" PasswordChar="&#x2022;"
                                       Watermark="Paste a key to set or replace it" FontSize="12" />
                              <Button Grid.Column="1" Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" MinWidth="80" HorizontalContentAlignment="Center" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="14">
                              <TextBlock Classes="stamp" Text="{Binding VaultEntry}" />
                              <TextBlock Classes="stamp" Text="{Binding Message}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="stamp" IsVisible="{Binding HasKeys}" TextWrapping="Wrap"
                     Text="Testing a key happens in the editor, on its Keys page. A test is one call in the provider's own shape, and offering it here would mean a second copy of every provider's authentication living in the hub." />
        </StackPanel>
      </ScrollViewer>

      <!-- Panels slide over from the right, behind one scrim. Click the scrim to leave. -->
      <Border IsVisible="{Binding ShowAnyPanel}" Background="#B30A0A0B" PointerPressed="Scrim_PointerPressed" />

      <!-- The account: who, how, and what is theirs. -->
      <Border IsVisible="{Binding ShowAccount}" HorizontalAlignment="Right" Width="400"
              Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer>
          <StackPanel Spacing="26" Margin="28,22,28,28">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Close" Command="{Binding CloseAccountCommand}" />
              <TextBlock Classes="label" Text="ACCOUNT" VerticalAlignment="Center" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" Spacing="16">
              <Panel Width="64" Height="64">
                <Ellipse Fill="{StaticResource InkBrush}" Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1" />
                <Ellipse IsVisible="{Binding HasAvatar}">
                  <Ellipse.Fill>
                    <ImageBrush Source="{Binding Avatar}" Stretch="UniformToFill" />
                  </Ellipse.Fill>
                </Ellipse>
                <Path IsVisible="{Binding !HasAvatar}" Data="M 7.5 8.5 A 4.5 4.5 0 1 1 16.5 8.5 A 4.5 4.5 0 1 1 7.5 8.5 M 3.5 23 C 3.5 18.5 7.3 15.5 12 15.5 C 16.7 15.5 20.5 18.5 20.5 23" Stroke="{StaticResource MuteBrush}" StrokeThickness="1.2" Fill="Transparent" Width="24" Height="24" Stretch="Uniform" Margin="16" />
              </Panel>
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="display" Text="{Binding AccountName}" FontSize="20" />
                <TextBlock Classes="stamp" Text="{Binding AccountEmail}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Classes="stamp" Text="Signs in with" />
                <TextBlock Grid.Column="1" Classes="mono" FontSize="12" Text="{Binding AccountProviders}" />
                <TextBlock Grid.Row="1" Classes="stamp" Text="Account id" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="stamp" Text="{Binding AccountUid}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="YOURS" />
              <TextBlock Classes="stamp" Text="{Binding OwnedLine}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Owned}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="mono" FontSize="13" Text="{Binding}" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost" Content="Manage on the web" Command="{Binding OpenAccountPageCommand}" />
              <Button Classes="ghost" Content="Sign out" Command="{Binding SignOutCommand}" />
            </StackPanel>
            <TextBlock Classes="stamp" Text="One account for the site, the hub and the command line." TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border IsVisible="{Binding ShowSettings}" HorizontalAlignment="Right" Width="400"
              Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer>
          <StackPanel Spacing="26" Margin="28,22,28,28">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Close" Command="{Binding ToggleSettingsCommand}" />
              <TextBlock Classes="label" Text="SETTINGS" VerticalAlignment="Center" />
            </DockPanel>

            <StackPanel Spacing="12">
              <TextBlock Classes="label" Text="CHANNEL" />
              <RadioButton GroupName="channel" IsChecked="{Binding IsStable, Mode=TwoWay}">
                <StackPanel Spacing="3">
                  <TextBlock Classes="display" Text="Stable" FontSize="14" />
                  <TextBlock Classes="stamp" Text="Tagged releases of the plugins and the hub. What most people should run." TextWrapping="Wrap" />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="channel" IsChecked="{Binding IsNightly, Mode=TwoWay}">
                <StackPanel Spacing="3">
                  <TextBlock Classes="display" Text="Nightly" FontSize="14" />
                  <TextBlock Classes="stamp" Text="Whatever is newest, including builds made from the day's work. Newer and less tested; a stable release published later takes over." TextWrapping="Wrap" />
                </StackPanel>
              </RadioButton>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="THIS HUB" />
              <TextBlock Classes="mono" Text="{Binding HubVersion}" />
              <TextBlock Classes="stamp" Text="{Binding InstallLocation}" TextWrapping="Wrap" />
              <CheckBox IsChecked="{Binding CheckForUpdates, Mode=TwoWay}">
                <TextBlock Classes="stamp" Text="Look for a newer hub at start" Foreground="{StaticResource BoneBrush}" />
              </CheckBox>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Content="Check now" Command="{Binding CheckHubUpdateCommand}" />
                <Button Classes="primary" Content="{Binding HubUpdateAction}" Command="{Binding ApplyHubUpdateCommand}" IsVisible="{Binding HasHubUpdate}" />
              </StackPanel>
              <TextBlock Classes="stamp" Text="{Binding HubUpdateLine}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="BACKGROUND" />
              <CheckBox IsChecked="{Binding RunInBackground, Mode=TwoWay}">
                <TextBlock Classes="stamp" Text="Keep running in the tray when the window closes" Foreground="{StaticResource BoneBrush}" TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" IsEnabled="{Binding CanAutostart}">
                <TextBlock Classes="stamp" Text="Start with Windows, in the tray" Foreground="{StaticResource BoneBrush}" />
              </CheckBox>
              <CheckBox IsChecked="{Binding NotifyOnUpdates, Mode=TwoWay}">
                <TextBlock Classes="stamp" Text="Notify me when updates appear" Foreground="{StaticResource BoneBrush}" />
              </CheckBox>
              <TextBlock Classes="stamp" Text="{Binding WatchLine}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="WHERE IT LOOKS" />
              <TextBlock Classes="stamp" TextWrapping="Wrap"
                         Text="Keys and runners are read from the plugins installed into your engines, and anywhere else the hub has installed. Add one more folder if you are developing a plugin - a working tree is not a release, so nothing it declares can appear here otherwise." />
              <TextBox Text="{Binding ExtraPluginRoot, Mode=TwoWay}" FontSize="12"
                       Watermark="A folder of plugins, e.g. C:\Project\Plugins\Forge" />
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="DATA" />
              <TextBlock Classes="stamp" Text="Receipts, settings and the download cache." />
              <TextBlock Classes="mono" Text="{Binding DataDir}" TextWrapping="Wrap" FontSize="12" />
              <Button Classes="ghost" Content="Open folder" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Panel>

    <!-- Footer: one line of status; details on demand; the hub's own update when there is one -->
    <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="{StaticResource PlateBrush}">
      <StackPanel>
        <Border IsVisible="{Binding ShowDetails}" MaxHeight="220" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,10,28,10">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Details}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="stamp" Text="{Binding}" Foreground="{StaticResource BoneBrush}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="28,9,20,9">
          <ProgressBar Grid.Column="0" IsIndeterminate="True" IsVisible="{Binding Busy}" Width="64" Height="2" Margin="0,0,14,0" Foreground="{StaticResource AmberBrush}" Background="{StaticResource LineBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="stamp" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="link amber" Content="{Binding HubUpdateLabel}" Command="{Binding ApplyHubUpdateCommand}" IsVisible="{Binding HasHubUpdate}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="3" Classes="stamp" Text="{Binding InstalledCount, StringFormat='{}{0} installed'}" Margin="0,0,18,0" VerticalAlignment="Center" />
          <Button Grid.Column="4" Classes="link" Content="Details" Command="{Binding ToggleDetailsCommand}" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
