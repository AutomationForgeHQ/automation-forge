<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Forge.Hub.ViewModels"
        xmlns:eng="using:Forge.Core.Engines"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="Forge.Hub.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1180" Height="760" MinWidth="1040" MinHeight="640"
        Background="{StaticResource InkBrush}"
        Icon="/Assets/forge.ico"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="Kovati Hub">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="56,*,Auto">

    <!-- The bar (spec 3): the mark and the name, the places, the account, the window buttons. One strip, 56 high,
         built like the account app's header. Every empty part of it drags the window. -->
    <Border Grid.Row="0" Background="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
            PointerPressed="TitleBar_PointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">

        <Button Grid.Column="0" Classes="plain" Command="{Binding GoHomeCommand}" Margin="18,0,0,0" CornerRadius="10" Padding="6,4"
                AutomationProperties.Name="Kovati Hub, Home" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Viewbox Width="28" Height="28">
              <Canvas Width="100" Height="100">
                <Path Data="{StaticResource MarkRing}" Stroke="{StaticResource BoneBrush}" StrokeThickness="6.5" />
                <Path Data="{StaticResource MarkBone}" Fill="{StaticResource BoneBrush}" />
                <Path Data="{StaticResource MarkAmber}" Fill="{StaticResource AmberBrush}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Kovati" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Classes="chip" BorderBrush="{StaticResource RingMidBrush}" VerticalAlignment="Center" Margin="2,1,0,0">
              <TextBlock Classes="chip" Text="HUB" FontSize="10" Foreground="{StaticResource MuteBrush}" />
            </Border>
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
          <Button Classes="place" Classes.selected="{Binding IsHomePlace}" Command="{Binding GoHomeCommand}">
            <Panel>
              <TextBlock Text="Home" VerticalAlignment="Center" />
              <Ellipse Classes="dot" Width="4" Height="4" Fill="{StaticResource AmberBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-14" />
            </Panel>
          </Button>
          <Button Classes="place" Classes.selected="{Binding IsLibraryPlace}" Command="{Binding ShowLibraryCommand}">
            <Panel>
              <TextBlock Text="Library" VerticalAlignment="Center" />
              <Ellipse Classes="dot" Width="4" Height="4" Fill="{StaticResource AmberBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-14" />
            </Panel>
          </Button>
          <Button Classes="place" Classes.selected="{Binding IsRunnersPlace}" Command="{Binding ShowRunnersPageCommand}" IsVisible="{Binding HasRunners}">
            <Panel>
              <TextBlock Text="Runners" VerticalAlignment="Center" />
              <Ellipse Classes="dot" Width="4" Height="4" Fill="{StaticResource AmberBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-14" />
            </Panel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,12,0">
          <!-- The updates pill (3, 8.1): only when there are updates; it opens Library on Updates. -->
          <Button Classes="pill" Content="{Binding PillLabel}" Command="{Binding ShowUpdatesCommand}" IsVisible="{Binding HasPill}" Margin="0,0,8,0" />
          <!-- Signed out: the quiet "Sign in", as on the site, and a gear for Keys, Settings and Help. -->
          <Button Classes="link" Content="Sign in" Command="{Binding SignInCommand}" IsVisible="{Binding !IsSignedIn}" FontSize="14" Margin="0,0,6,0" />
          <Button x:Name="GearButton" Classes="round" Width="34" Height="34" IsVisible="{Binding !IsSignedIn}"
                  AutomationProperties.Name="Keys, settings and help" ToolTip.Tip="Keys, settings and help">
            <Path Data="M12 8.5 A3.5 3.5 0 1 1 11.99 8.5 Z M12 2 L13.4 4.6 L16.3 3.9 L16.8 6.8 L19.6 7.9 L18.6 10.7 L20.6 12.9 L18.4 14.8 L19.1 17.7 L16.2 18.2 L15 20.9 L12.3 19.7 L9.5 21 L8.4 18.3 L5.5 17.8 L6.2 14.9 L4 12.9 L6 10.7 L5 7.9 L7.8 6.8 L8.3 3.9 L11.2 4.6 Z"
                  Stroke="{StaticResource Bone80Brush}" StrokeThickness="1.3" Width="16" Height="16" Stretch="Uniform" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="288" Margin="6">
                  <Button Classes="menurow" Click="MenuRow_Click" Command="{Binding ShowKeysCommand}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Keys" FontSize="14" FontWeight="Medium" />
                        <TextBlock Classes="small" Text="API keys for the engines you use" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="small amber" Text="{Binding KeysMissing, StringFormat='{}{0} needed'}" IsVisible="{Binding HasKeysMissing}" VerticalAlignment="Top" />
                    </Grid>
                  </Button>
                  <Button Classes="menurow" Click="MenuRow_Click" Command="{Binding ToggleSettingsCommand}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Settings" FontSize="14" FontWeight="Medium" />
                      <TextBlock Classes="small" Text="Channel, background, folders" />
                    </StackPanel>
                  </Button>
                  <Border Classes="hairline" Margin="12,6" />
                  <TextBlock Classes="label" Text="HELP" Margin="12,6,12,4" />
                  <Button Classes="menurow" Click="MenuRow_Click" Command="{Binding OpenDocsCommand}"><TextBlock Text="Docs ↗" FontSize="14" /></Button>
                  <Button Classes="menurow" Click="MenuRow_Click" Command="{Binding OpenDiscordCommand}"><TextBlock Text="Discord ↗" FontSize="14" /></Button>
                  <Button Classes="menurow" Click="MenuRow_Click" Command="{Binding EmailUsCommand}"><TextBlock Text="Email us" FontSize="14" /></Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Signed in: the circle, the photo or the first letter on the site's hot-to-amber gradient, and a chevron.
               A small amber dot when keys are missing. -->
          <Button x:Name="AvatarButton" Classes="avatar" IsVisible="{Binding IsSignedIn}" ToolTip.Tip="{Binding AccountEmail}" AutomationProperties.Name="Account menu">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Panel Width="32" Height="32">
                <Ellipse>
                  <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                      <GradientStop Color="#FFC44D" Offset="0" />
                      <GradientStop Color="#EBAA28" Offset="1" />
                    </LinearGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding AccountInitial}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse IsVisible="{Binding HasAvatar}">
                  <Ellipse.Fill>
                    <ImageBrush Source="{Binding Avatar}" Stretch="UniformToFill" />
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Classes="ring" Stroke="{StaticResource RingMidBrush}" StrokeThickness="1" />
                <Ellipse Width="9" Height="9" Fill="{StaticResource AmberBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" IsVisible="{Binding HasKeysMissing}" />
              </Panel>
              <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource MuteBrush}" StrokeThickness="1.4" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="288">
                  <Border Height="1" CornerRadius="16,16,0,0">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#00EBAA28" Offset="0" />
                        <GradientStop Color="#EBAA28" Offset="0.5" />
                        <GradientStop Color="#00EBAA28" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="12" Margin="18,16,18,14">
                    <Panel Width="40" Height="40">
                      <Ellipse>
                        <Ellipse.Fill>
                          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#FFC44D" Offset="0" />
                            <GradientStop Color="#EBAA28" Offset="1" />
                          </LinearGradientBrush>
                        </Ellipse.Fill>
                      </Ellipse>
                      <TextBlock Text="{Binding AccountInitial}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Ellipse IsVisible="{Binding HasAvatar}">
                        <Ellipse.Fill>
                          <ImageBrush Source="{Binding Avatar}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                      </Ellipse>
                    </Panel>
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                      <TextBlock Classes="label" Text="ACCOUNT" FontSize="10" />
                      <TextBlock Text="{Binding AccountName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                    </StackPanel>
                  </StackPanel>
                  <Border Classes="hairline" />
                  <StackPanel Margin="6">
                    <Button Classes="menurow" Click="MenuRow_Click" Command="{Binding OpenAccountCommand}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Your account" FontSize="14" FontWeight="Medium" />
                        <TextBlock Classes="small" Text="What you own, on this computer" />
                      </StackPanel>
                    </Button>
                    <Button Classes="menurow" Click="MenuRow_Click" Command="{Binding ShowKeysCommand}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="Keys" FontSize="14" FontWeight="Medium" />
                          <TextBlock Classes="small" Text="API keys for the engines you use" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="small amber" Text="{Binding KeysMissing, StringFormat='{}{0} needed'}" IsVisible="{Binding HasKeysMissing}" VerticalAlignment="Top" />
                      </Grid>
                    </Button>
                    <Button Classes="menurow" Click="MenuRow_Click" Command="{Binding ToggleSettingsCommand}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Settings" FontSize="14" FontWeight="Medium" />
                        <TextBlock Classes="small" Text="Channel, background, folders" />
                      </StackPanel>
                    </Button>
                    <TextBlock Classes="label" Text="HELP" Margin="12,10,12,4" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="12,0,12,6">
                      <Button Classes="link smalltext" Content="Docs ↗" Click="MenuRow_Click" Command="{Binding OpenDocsCommand}" />
                      <Button Classes="link smalltext" Content="Discord ↗" Click="MenuRow_Click" Command="{Binding OpenDiscordCommand}" />
                      <Button Classes="link smalltext" Content="Email us" Click="MenuRow_Click" Command="{Binding EmailUsCommand}" />
                    </StackPanel>
                  </StackPanel>
                  <Border Classes="hairline" />
                  <Button Classes="menurow" Margin="6" Click="MenuRow_Click" Command="{Binding SignOutCommand}">
                    <TextBlock Text="Sign out" FontSize="14" Foreground="{StaticResource MuteBrush}" />
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button Classes="caption" Click="Minimize_Click" ToolTip.Tip="Minimise">
            <Path Data="M 0 5 H 10" Stroke="{StaticResource BoneBrush}" Opacity="0.75" StrokeThickness="1" Width="10" Height="10" />
          </Button>
          <Button Classes="caption" Click="Maximize_Click" ToolTip.Tip="Maximise">
            <Path Data="M 0.5 0.5 H 9.5 V 9.5 H 0.5 Z" Stroke="{StaticResource BoneBrush}" Opacity="0.75" StrokeThickness="1" Fill="Transparent" Width="10" Height="10" />
          </Button>
          <Button Classes="caption close" Click="Close_Click" ToolTip.Tip="Close">
            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{StaticResource BoneBrush}" Opacity="0.75" StrokeThickness="1" Width="10" Height="10" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The page, and the drawers that slide over it from the right. -->
    <Panel Grid.Row="1">
      <ContentControl Content="{Binding CurrentPage}" />

      <Border IsVisible="{Binding ShowAnyPanel}" Background="{StaticResource ScrimBrush}" PointerPressed="Scrim_PointerPressed" />

      <!-- Your account: who, and what is theirs. -->
      <Border IsVisible="{Binding ShowAccount}" HorizontalAlignment="Right" Width="400" CornerRadius="16,0,0,16"
              Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource RingSoftBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer>
          <StackPanel Spacing="24" Margin="28,22,28,28">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Close" Command="{Binding CloseAccountCommand}" />
              <TextBlock Classes="label amber" Text="YOUR ACCOUNT" VerticalAlignment="Center" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" Spacing="16">
              <Panel Width="56" Height="56">
                <Ellipse>
                  <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                      <GradientStop Color="#FFC44D" Offset="0" />
                      <GradientStop Color="#EBAA28" Offset="1" />
                    </LinearGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding AccountInitial}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse IsVisible="{Binding HasAvatar}">
                  <Ellipse.Fill>
                    <ImageBrush Source="{Binding Avatar}" Stretch="UniformToFill" />
                  </Ellipse.Fill>
                </Ellipse>
              </Panel>
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="display-xs" Text="{Binding AccountName}" />
                <TextBlock Classes="small" Text="{Binding AccountEmail}" />
              </StackPanel>
            </StackPanel>

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock Classes="small" Text="Signs in with" />
              <TextBlock Grid.Column="1" Classes="body" Text="{Binding AccountProviders}" />
              <TextBlock Grid.Row="1" Classes="small" Text="Account id" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Foreground="{StaticResource MuteBrush}" Text="{Binding AccountUid}" TextTrimming="CharacterEllipsis" />
            </Grid>

            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="YOURS" />
              <TextBlock Classes="small" Text="{Binding OwnedLine}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Owned}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="mono" FontSize="13" Text="{Binding}" Margin="0,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="quiet small" Content="Manage on the web ↗" Command="{Binding OpenAccountPageCommand}" />
              <Button Classes="quiet small" Content="Sign out" Command="{Binding SignOutCommand}" />
            </StackPanel>
            <TextBlock Classes="small" Text="One account for kovati.dev, Kovati Hub and the command line." TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Keys: machine-wide, shared with the editor. -->
      <Border IsVisible="{Binding ShowKeysPanel}" HorizontalAlignment="Right" Width="440" CornerRadius="16,0,0,16"
              Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource RingSoftBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer>
          <StackPanel Spacing="20" Margin="28,22,28,28">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Close" Command="{Binding CloseKeysCommand}" />
              <TextBlock Classes="label amber" Text="KEYS" VerticalAlignment="Center" />
            </DockPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="body" Text="{Binding KeysLine}" TextWrapping="Wrap" />
              <TextBlock Classes="small" TextWrapping="Wrap"
                         Text="One vault, shared with the editor. A key set here is set for every project on this machine." />
            </StackPanel>

            <TextBlock Classes="small" IsVisible="{Binding !HasKeys}" TextWrapping="Wrap"
                       Text="Nothing installed asks for a key. Only tools installed into an engine appear here, and only once they say what they need." />

            <ItemsControl ItemsSource="{Binding KeyGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyGroup">
                  <StackPanel Spacing="8" Margin="0,4,0,14">
                    <TextBlock Classes="label amber" Text="{Binding Plugin}" />

                    <ItemsControl ItemsSource="{Binding Keys}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KeyRow">
                          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
                            <StackPanel Spacing="8">
                              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource LineStrongBrush}" />
                                <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" IsVisible="{Binding IsSet}" Fill="{StaticResource GoodBrush}" />
                                <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" IsVisible="{Binding IsMissing}" Fill="{StaticResource AmberBrush}" />
                                <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="link smalltext" Content="Where from ↗" Command="{Binding HelpCommand}" IsVisible="{Binding HasHelp}" />
                              </Grid>
                              <TextBlock Classes="small" Text="{Binding Purpose}" TextWrapping="Wrap" />
                              <TextBlock Classes="small" Text="{Binding ConsumersLine}" IsVisible="{Binding HasConsumers}" Foreground="{StaticResource Bone80Brush}" TextWrapping="Wrap" />
                              <StackPanel Spacing="6" IsVisible="{Binding HasAccess}">
                                <TextBlock Classes="small amber" TextWrapping="Wrap" Text="A token is not access. You must also be granted:" />
                                <ItemsControl ItemsSource="{Binding Access}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccessRow">
                                      <StackPanel Spacing="2" Margin="10,0,0,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                          <TextBlock Classes="small" Text="{Binding What}" TextWrapping="Wrap" Foreground="{StaticResource BoneBrush}" VerticalAlignment="Center" />
                                          <Button Classes="link smalltext" Content="{Binding ActionLabel}" Command="{Binding OpenCommand}" />
                                        </StackPanel>
                                        <TextBlock Classes="small" Text="{Binding Timing}" TextWrapping="Wrap" />
                                        <TextBlock Classes="small" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                              <TextBlock Classes="small" Text="{Binding StatusLine}" Foreground="{StaticResource Bone80Brush}" TextWrapping="Wrap" />
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding Secret, Mode=TwoWay}" PasswordChar="&#x2022;"
                                         PlaceholderText="Paste a key to set or replace it" FontSize="13" />
                                <Button Grid.Column="1" Classes="primary small" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
                              </Grid>
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="quiet small" Content="Remove" Command="{Binding ClearCommand}" IsVisible="{Binding CanClear}" />
                                <TextBlock Classes="small amber" Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="small" IsVisible="{Binding HasKeys}" TextWrapping="Wrap"
                       Text="Testing a key happens in the editor, on its Keys page. A test is one call in the service's own shape, and offering it here would mean a second copy of every service's sign-in living in Kovati Hub." />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Settings. -->
      <Border IsVisible="{Binding ShowSettings}" HorizontalAlignment="Right" Width="400" CornerRadius="16,0,0,16"
              Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource RingSoftBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer>
          <StackPanel Spacing="26" Margin="28,22,28,28">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Close" Command="{Binding ToggleSettingsCommand}" />
              <TextBlock Classes="label amber" Text="SETTINGS" VerticalAlignment="Center" />
            </DockPanel>

            <!-- AGENTS and LABS (6.2, 9.3): one switch each, for the whole machine. -->
            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="AGENTS" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Use with AI agents" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AgentAccessSetting, Mode=TwoWay}" />
              </Grid>
              <TextBlock Classes="small" TextWrapping="Wrap"
                         Text="When this is on, every tool you install also gets agent access. Unreal's own Model Context Protocol plugin does the talking; the agent connects to the editor." />
              <StackPanel Spacing="8" IsVisible="{Binding ShowAddAgentAccess}" Margin="0,4,0,0">
                <TextBlock Classes="small" Text="{Binding AddAgentAccessLine}" Foreground="{StaticResource Bone90Brush}" TextWrapping="Wrap" />
                <Button Classes="quiet small" Content="Add agent access to them" Command="{Binding AddAgentAccessCommand}" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Spacing="6" IsVisible="{Binding ShowRemoveAgentAccess}" Margin="0,4,0,0">
                <TextBlock Classes="small" Text="Agent access stays installed until you remove it." TextWrapping="Wrap" />
                <Button Classes="link smalltext" Content="{Binding RemoveAgentAccessLabel}" Command="{Binding RemoveAgentAccessCommand}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="LABS" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Show Labs" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowLabsSetting, Mode=TwoWay}" />
              </Grid>
              <TextBlock Classes="small" TextWrapping="Wrap"
                         Text="Labs holds our early experiments. They work for us, may break, and get no support yet. A track never installs a Labs part unless you tick it." />
            </StackPanel>

            <StackPanel Spacing="12">
              <TextBlock Classes="label" Text="CHANNEL" />
              <RadioButton GroupName="channel" IsChecked="{Binding IsStable, Mode=TwoWay}">
                <StackPanel Spacing="3">
                  <TextBlock Text="Stable" FontSize="14" FontWeight="Medium" />
                  <TextBlock Classes="small" Text="Tagged releases of the tools and of Kovati Hub. What most people should run." TextWrapping="Wrap" />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="channel" IsChecked="{Binding IsNightly, Mode=TwoWay}">
                <StackPanel Spacing="3">
                  <TextBlock Text="Nightly" FontSize="14" FontWeight="Medium" />
                  <TextBlock Classes="small" Text="Whatever is newest, including builds made from the day's work. Newer and less tested; a stable release published later takes over." TextWrapping="Wrap" />
                </StackPanel>
              </RadioButton>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="KOVATI HUB" />
              <TextBlock Classes="mono" Text="{Binding HubVersion}" />
              <TextBlock Classes="small" Text="{Binding InstallLocation}" TextWrapping="Wrap" />
              <CheckBox IsChecked="{Binding CheckForUpdates, Mode=TwoWay}">
                <TextBlock Text="Look for a newer Kovati Hub at start" FontSize="13" />
              </CheckBox>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="quiet small" Content="Check now" Command="{Binding CheckHubUpdateCommand}" />
                <Button Classes="primary small" Content="{Binding HubUpdateAction}" Command="{Binding ApplyHubUpdateCommand}" IsVisible="{Binding HasHubUpdate}" />
              </StackPanel>
              <TextBlock Classes="small" Text="{Binding HubUpdateLine}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="BACKGROUND" />
              <CheckBox IsChecked="{Binding RunInBackground, Mode=TwoWay}">
                <TextBlock Text="Keep running in the tray when the window closes" FontSize="13" TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" IsEnabled="{Binding CanAutostart}">
                <TextBlock Text="Start with Windows, in the tray" FontSize="13" />
              </CheckBox>
              <CheckBox IsChecked="{Binding NotifyOnUpdates, Mode=TwoWay}">
                <TextBlock Text="Notify me when updates appear" FontSize="13" />
              </CheckBox>
              <TextBlock Classes="small" Text="{Binding WatchLine}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="WHERE IT LOOKS" />
              <TextBlock Classes="small" TextWrapping="Wrap"
                         Text="Keys and runners are read from the tools installed into your engines, and anywhere else Kovati Hub has installed. Add one more folder if you are developing a plugin: a working tree is not a release, so nothing it declares can appear here otherwise." />
              <TextBox Text="{Binding ExtraPluginRoot, Mode=TwoWay}" FontSize="13"
                       PlaceholderText="A folder of plugins, e.g. C:\Project\Plugins\Forge" />
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="DATA" />
              <TextBlock Classes="small" Text="Receipts, settings, your choices and the download cache." />
              <TextBlock Classes="mono" Text="{Binding DataDir}" TextWrapping="Wrap" Foreground="{StaticResource MuteBrush}" />
              <Button Classes="quiet small" Content="Open folder" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Panel>

    <!-- The footer (spec 3): the install target, the status line and the busy bar, the Hub's own update, Details. -->
    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="{StaticResource InkBrush}">
      <StackPanel>
        <Border IsVisible="{Binding ShowDetails}" MaxHeight="220" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,10">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Details}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="mono" Text="{Binding}" Foreground="{StaticResource Bone80Brush}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Height="32" Margin="16,0,18,0">
          <ComboBox Grid.Column="0" Classes="footer" ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}" IsVisible="{Binding HasManyEngines}" VerticalAlignment="Center" MaxWidth="300">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="eng:EngineInstall">
                <TextBlock Text="{Binding FullVersion, StringFormat='Unreal Engine {0}'}" FontSize="12" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Column="0" Text="{Binding EngineLabel}" FontSize="12" Foreground="{StaticResource Bone80Brush}" VerticalAlignment="Center" Margin="8,0,0,0"
                     IsVisible="{Binding IsSingleEngine}" />
          <Button Grid.Column="0" Classes="link amber smalltext" Content="{Binding EngineLabel}" Command="{Binding GetUnrealEngineCommand}" FontSize="12" Margin="8,0,0,0"
                  IsVisible="{Binding !HasEngine}" VerticalAlignment="Center" />
          <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding Busy}" Width="56" Height="2" MinWidth="0" Margin="18,0,0,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12" Foreground="{StaticResource MuteBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="18,0,12,0" />
          <Button Grid.Column="3" Classes="link amber smalltext" Content="Move tools to the engine's Marketplace folder" Command="{Binding MoveLegacyInstallsCommand}" IsVisible="{Binding HasLegacyInstalls}" Margin="0,0,16,0" FontSize="12" VerticalAlignment="Center"
                  ToolTip.Tip="Tools installed by an older Hub sit in Engine/Plugins/AutomationForge, where they stop C++ builds on this engine. Moving them needs administrator rights and a closed Unreal Editor." />
          <Button Grid.Column="4" Classes="link amber smalltext" Content="{Binding HubUpdateLabel}" Command="{Binding ApplyHubUpdateCommand}" IsVisible="{Binding HasHubUpdate}" Margin="0,0,16,0" FontSize="12" VerticalAlignment="Center" />
          <Button Grid.Column="5" Classes="link smalltext" Content="Details" Command="{Binding ToggleDetailsCommand}" FontSize="12" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
