<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Forge.Hub.ViewModels.Pages"
             xmlns:vm="using:Forge.Hub.ViewModels"
             xmlns:core="using:Forge.Core.Catalogue"
             xmlns:views="using:Forge.Hub.Views"
             xmlns:man="using:Forge.Core.Manifest"
             xmlns:c="using:Forge.Hub.Controls"
             x:Class="Forge.Hub.Views.Pages.ProductPageView"
             x:DataType="p:ProductPageViewModel">

  <Panel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="32,14,32,40" MaxWidth="1336">
        <Button Classes="link" Content="{Binding BackLabel}" Command="{Binding Hub.GoBackCommand}" IsVisible="{Binding HasBack}" FontSize="14" Margin="0,0,0,12" HorizontalAlignment="Left" />

        <!-- The picture at the left, 16:9; the identity, the line and the button at the right. -->
        <Grid ColumnDefinitions="620,32,*">
          <StackPanel Spacing="10">
            <Border CornerRadius="16" ClipToBounds="True" Background="{StaticResource PlateBrush}">
              <c:Ratio Value="0.5625">
                <Panel>
                  <c:TypographicPoster Mark="{Binding Mark}" Slug="{Binding Slug}" IsVisible="{Binding !HasPicture}" />
                  <c:MediaImage Path="{Binding Picture}" DecodeWidth="640" IsVisible="{Binding HasPicture}" />
                  <Button Classes="quiet small" Command="{Binding OpenFilmCommand}" IsVisible="{Binding HasFilm}" Background="{StaticResource ChipDarkBrush}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" ToolTip.Tip="Opens the film on kovati.dev">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Data="M 0 0 L 8 5 L 0 10 Z" Fill="{StaticResource BoneBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="The film" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Panel>
              </c:Ratio>
            </Border>
            <ItemsControl ItemsSource="{Binding Shots}" IsVisible="{Binding HasShots}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:ShotModel">
                  <Button Classes="plain card" Command="{Binding OpenCommand}" Width="96" Height="60" CornerRadius="8" ToolTip.Tip="{Binding Label}">
                    <Panel>
                      <Border CornerRadius="8" ClipToBounds="True" Background="{StaticResource PlateBrush}">
                        <c:MediaImage Classes="pic" Path="{Binding Src}" DecodeWidth="96" />
                      </Border>
                      <Border Classes="ring" CornerRadius="8" />
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="0">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="chip" BorderBrush="{StaticResource RingMidBrush}">
                <TextBlock Classes="chip" Text="{Binding TypeLine}" />
              </Border>
              <Button Classes="link smalltext" Command="{Binding OpenTrackCommand}" IsVisible="{Binding HasTrack}" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="{Binding TrackName}" FontSize="11" />
              </Button>
            </StackPanel>
            <TextBlock Classes="display-l" Text="{Binding Name}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
              <ItemsControl ItemsSource="{Binding Chips}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Classes="mono" Text="{Binding VersionLine}" Foreground="{StaticResource MuteBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding LabsLine}" IsVisible="{Binding IsLabs}" FontSize="13" Foreground="{StaticResource HotBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Classes="title" Text="{Binding Promise}" IsVisible="{Binding HasPromise}" TextWrapping="Wrap" Margin="0,18,0,0" />
            <TextBlock Text="{Binding Subline}" FontSize="14" LineHeight="21" Foreground="{StaticResource Bone80Brush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <!-- The main button, and for a free tier (beta 7) "Buy Full · $99.99" beside it; they wrap in a narrow column. -->
            <WrapPanel Orientation="Horizontal" Margin="0,22,0,0">
              <Button Classes="primary" Content="{Binding ButtonText}" Command="{Binding ActCommand}" IsEnabled="{Binding ButtonEnabled}" MinWidth="{Binding PrimaryMinWidth}" Margin="0,0,12,8" />
              <Button Classes="quiet" Content="{Binding BuyFullText}" Command="{Binding BuyFullCommand}" IsEnabled="{Binding BuyFullEnabled}" IsVisible="{Binding HasBuyFull}" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock Classes="small" Text="{Binding ButtonLine}" TextWrapping="Wrap" Margin="0,0,0,0" />
            <!-- The licence (licensing step 2): one quiet line, and Restore licence, which is only the refresh. -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,10,0,0" IsVisible="{Binding HasLicenceRow}">
              <TextBlock Classes="small" Text="{Binding LicenceLine}" IsVisible="{Binding HasLicenceLine}" Foreground="{StaticResource Bone80Brush}" VerticalAlignment="Center" />
              <Button Classes="link smalltext" Content="{Binding Hub.RestoreLicenceLabel}" Command="{Binding RestoreLicenceCommand}" IsVisible="{Binding CanRestoreLicence}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Install into (0.5.0-beta.3): the same targets as the footer and the track pages. -->
            <StackPanel Spacing="4" Margin="0,12,0,0" IsVisible="{Binding HasManyTargets}" MaxWidth="420" HorizontalAlignment="Left">
              <TextBlock Classes="small" Text="Install into" />
              <ComboBox ItemsSource="{Binding Hub.Targets}" SelectedItem="{Binding Hub.SelectedTarget}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TargetOption">
                    <TextBlock Text="{Binding MenuLabel}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="small" Text="{Binding ProjectTargetLine}" IsVisible="{Binding IsProjectTarget}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,16,0,0">
              <Button Classes="link smalltext" Content="Open on kovati.dev ↗" Command="{Binding OpenSiteCommand}" IsVisible="{Binding HasSite}" />
              <Button Classes="link smalltext" Content="Docs ↗" Command="{Binding OpenDocsCommand}" IsVisible="{Binding HasDocs}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- The optional blocks, each only when there is something for it. -->
        <StackPanel IsVisible="{Binding HasAdds}" Margin="0,40,0,0">
          <TextBlock Classes="label" Text="WHAT IT ADDS" Margin="0,0,0,14" />
          <ItemsControl ItemsSource="{Binding Adds}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" ColumnSpacing="32" RowSpacing="16" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:TitleLine">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Classes="small" Text="{Binding Line}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="link smalltext" Content="All of it on kovati.dev ↗" Command="{Binding OpenSiteCommand}" IsVisible="{Binding HasMoreAdds}" Margin="0,12,0,0" />
        </StackPanel>

        <StackPanel IsVisible="{Binding HasEngines}" Margin="0,40,0,0">
          <TextBlock Classes="label" Text="CHOOSE YOUR ENGINE" Margin="0,0,0,14" />
          <ItemsControl ItemsSource="{Binding Engines}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" ColumnSpacing="20" RowSpacing="20" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="p:EnginePanelModel">
                <Border Classes="panel" Padding="20,18">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="title" Text="{Binding Runs}" FontSize="15" TextWrapping="Wrap" />
                        <ContentControl Content="{Binding LabsChip}" IsVisible="{Binding IsLabs}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="small" Text="{Binding Vendor}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding Line}" FontSize="14" Foreground="{StaticResource Bone80Brush}" TextWrapping="Wrap" />
                    <TextBlock Classes="small" Text="{Binding NeedsLine}" IsVisible="{Binding HasNeeds}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                      <ContentControl Content="{Binding PriceChip}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="quiet small" Content="{Binding ActionText}" Command="{Binding ActCommand}" IsEnabled="{Binding CanAct}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasInside}" Margin="0,40,0,0" Spacing="10">
          <TextBlock Classes="label" Text="WHAT COMES WITH IT" />
          <TextBlock Text="{Binding Inside.Line}" FontSize="15" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Inside.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:NameLine">
                <Grid ColumnDefinitions="220,*" Margin="0,6">
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Classes="small" Text="{Binding Line}" TextWrapping="Wrap" FontSize="14" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasTakes}" Margin="0,40,0,0" Spacing="6">
          <TextBlock Classes="label" Text="WHAT IT TAKES" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Takes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:NameLine">
                <Grid ColumnDefinitions="260,*" Margin="0,6">
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Classes="small" Text="{Binding Line}" TextWrapping="Wrap" FontSize="14" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="small" Text="{Binding PriceLine}" IsVisible="{Binding HasPriceLine}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel IsVisible="{Binding HasEditions}" Margin="0,40,0,0">
          <TextBlock Classes="label" Text="EDITIONS" Margin="0,0,0,14" />
          <ItemsControl ItemsSource="{Binding Editions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" ColumnSpacing="20" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="p:EditionModel">
                <Border Classes="panel" Padding="20,16">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="title" Text="{Binding Name}" FontSize="15" />
                      <ContentControl Content="{Binding Chip}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="small" Text="{Binding Line}" TextWrapping="Wrap" FontSize="14" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasCharacters}" Margin="0,40,0,0">
          <TextBlock Classes="label" Text="WORKS WITH" Margin="0,0,0,10" />
          <ItemsControl ItemsSource="{Binding Characters}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:NameLine">
                <Grid ColumnDefinitions="220,*" Margin="0,6">
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Classes="small" Text="{Binding Line}" TextWrapping="Wrap" FontSize="14" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasExtensions}" Margin="0,40,0,0">
          <TextBlock Classes="label" Text="EXTEND IT" Margin="0,0,0,14" />
          <ItemsControl ItemsSource="{Binding Extensions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" ColumnSpacing="20" RowSpacing="20" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasContents}" Margin="0,40,0,0" Spacing="8">
          <TextBlock Classes="label" Text="IN THE PACK" />
          <TextBlock Text="{Binding Contents}" FontSize="15" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel IsVisible="{Binding HasSoftware}" Margin="0,40,0,0" Spacing="8">
          <TextBlock Classes="label" Text="RUNS THROUGH" />
          <TextBlock Text="{Binding Software}" FontSize="15" TextWrapping="Wrap" />
        </StackPanel>

        <Grid ColumnDefinitions="*,40,*" Margin="0,40,0,0">
          <StackPanel Spacing="22">
            <StackPanel IsVisible="{Binding HasAgents}" Spacing="8">
              <TextBlock Classes="label" Text="WORKS WITH AGENTS" />
              <TextBlock Text="{Binding AgentsLine}" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource Bone80Brush}" />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="ON THIS COMPUTER" />
              <TextBlock Text="{Binding OnThisComputer}" FontSize="14" />
              <StackPanel Orientation="Horizontal" Spacing="20" IsVisible="{Binding IsInstalled}">
                <Button Classes="link smalltext" Content="Remove" Command="{Binding AskRemoveCommand}" />
                <Button Classes="link smalltext" Content="{Binding PinLabel}" Command="{Binding TogglePinCommand}" />
                <Button Classes="link smalltext" Content="Show components" Command="{Binding ShowComponentsCommand}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" IsVisible="{Binding HasNotes}" Spacing="8">
            <TextBlock Classes="label" Text="WHAT'S NEW" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="title" Text="{Binding Newest.Version}" FontSize="15" />
              <TextBlock Classes="small" Text="{Binding Newest.Date}" VerticalAlignment="Center" />
            </StackPanel>
            <views:MarkdownBlock Markdown="{Binding Newest.Body}" />
            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,4,0,0">
              <Button Classes="link smalltext" Content="Earlier versions ⌄" Command="{Binding ToggleEarlierCommand}" IsVisible="{Binding HasEarlier}" />
              <Button Classes="link smalltext" Content="Full changelog on docs.kovati.dev ↗" Command="{Binding OpenChangelogCommand}" IsVisible="{Binding HasChangelog}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Earlier}" IsVisible="{Binding EarlierOpen}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="man:ChangelogEntry">
                  <StackPanel Spacing="6" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="title" Text="{Binding Version}" FontSize="15" />
                      <TextBlock Classes="small" Text="{Binding Date}" VerticalAlignment="Center" />
                    </StackPanel>
                    <views:MarkdownBlock Markdown="{Binding Body}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- Remove, asked once. -->
    <Border Background="{StaticResource ScrimBrush}" IsVisible="{Binding ShowRemoveDialog}">
      <Border Classes="panel" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24">
        <StackPanel Spacing="12">
          <TextBlock Classes="display-xs" Text="{Binding RemoveTitle}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding RemoveLine}" FontSize="14" Foreground="{StaticResource Bone80Brush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Classes="quiet small" Content="Keep" Command="{Binding KeepCommand}" />
            <Button Classes="primary small" Content="Remove" Command="{Binding ConfirmRemoveCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- The picture viewer (4.12): a still on a deep scrim, its label and caption, arrows, close. -->
    <Border Background="{StaticResource ScrimDeepBrush}" IsVisible="{Binding ShowViewer}" PointerPressed="Viewer_PointerPressed">
      <Grid RowDefinitions="*,Auto" Margin="48">
        <c:MediaImage Path="{Binding ViewerShot.Src}" Stretch="Uniform" DecodeWidth="1100" />
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,16,0,0" HorizontalAlignment="Center" MaxWidth="760">
          <TextBlock Classes="title" Text="{Binding ViewerShot.Label}" HorizontalAlignment="Center" />
          <TextBlock Classes="small" Text="{Binding ViewerShot.Caption}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" />
        </StackPanel>
        <Button Classes="round" Command="{Binding PreviousShotCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="Previous">
          <Path Data="M 6 0 L 0 6 L 6 12" Stroke="{StaticResource BoneBrush}" StrokeThickness="1.5" />
        </Button>
        <Button Classes="round" Command="{Binding NextShotCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Next">
          <Path Data="M 0 0 L 6 6 L 0 12" Stroke="{StaticResource BoneBrush}" StrokeThickness="1.5" />
        </Button>
        <Button Classes="round" Command="{Binding CloseViewerCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-32,-32,0" AutomationProperties.Name="Close">
          <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{StaticResource BoneBrush}" StrokeThickness="1.4" />
        </Button>
      </Grid>
    </Border>
  </Panel>
</UserControl>
