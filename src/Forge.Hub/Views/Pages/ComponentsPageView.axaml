<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Forge.Hub.ViewModels.Pages"
             xmlns:vm="using:Forge.Hub.ViewModels"
             xmlns:views="using:Forge.Hub.Views"
             xmlns:man="using:Forge.Core.Manifest"
             x:Class="Forge.Hub.Views.Pages.ComponentsPageView"
             x:DataType="p:ComponentsPageViewModel">

  <!-- "Everything on this machine" (4.9): today's list of components, restyled, kept for developers and support. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,14,32,32" MaxWidth="1336">
      <Button Classes="link" Content="{Binding BackLabel}" Command="{Binding Hub.GoBackCommand}" IsVisible="{Binding HasBack}" FontSize="14" Margin="0,0,0,12" HorizontalAlignment="Left" />

      <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
        <StackPanel Spacing="8">
          <TextBlock Classes="label amber" Text="LIBRARY" />
          <TextBlock Classes="display-l" Text="Everything on this machine" />
          <TextBlock Classes="small" Text="{Binding SummaryLine}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
          <TextBox Text="{Binding Filter, Mode=TwoWay}" PlaceholderText="Filter by id" Width="240" Height="36" FontSize="13" />
          <Button Classes="primary small" Content="Update all" Command="{Binding Hub.UpdateAllCommand}" IsVisible="{Binding Hub.HasUpdates}" />
          <Button Classes="quiet small" Content="Check now" Command="{Binding Hub.RefreshCommand}" />
        </StackPanel>
      </Grid>

      <TextBlock Classes="small" Text="{Binding EmptyLine}" IsVisible="{Binding IsEmpty}" Margin="0,32,0,0" FontSize="14" />

      <ItemsControl ItemsSource="{Binding Families}" Margin="0,22,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="p:ComponentFamilyModel">
            <StackPanel Margin="0,0,0,26">
              <TextBlock Classes="label" Text="{Binding Name}" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PluginRow">
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                      <StackPanel>
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Classes="mono" Text="{Binding Id}" FontSize="14" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="small" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" MinWidth="190">
                          <TextBlock Classes="mono" Text="{Binding VersionLine}" />
                          <TextBlock Classes="small" Text="{Binding Status}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Button Classes="link smalltext" Content="Remove" Command="{Binding UninstallCommand}" IsVisible="{Binding CanUninstall}" Margin="0,0,8,0" />
                          <Button Classes="quiet small" Content="What's new" Command="{Binding ShowChangesCommand}" IsVisible="{Binding CanShowChanges}" ToolTip.Tip="{Binding ChangesTip}" />
                          <Button Classes="primary small" Content="{Binding ActionLabel}" Command="{Binding ActCommand}" MinWidth="104" />
                        </StackPanel>
                      </Grid>
                      <!-- What's new, in place: every version between the installed one and the offered one, newest first. -->
                      <ItemsControl ItemsSource="{Binding Changes}" IsVisible="{Binding NotesOpen}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="man:ChangelogEntry">
                            <Border Classes="panel" Padding="20,14" Margin="0,0,0,10">
                              <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                  <TextBlock Classes="title" Text="{Binding Version}" />
                                  <TextBlock Classes="small" Text="{Binding Date}" VerticalAlignment="Center" />
                                </StackPanel>
                                <views:MarkdownBlock Markdown="{Binding Body}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel IsVisible="{Binding HasOthers}" Spacing="8" Margin="0,8,0,0">
        <TextBlock Classes="label" Text="ON OTHER TARGETS" />
        <ItemsControl ItemsSource="{Binding Others}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="p:OtherReceipt">
              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                <Grid ColumnDefinitions="260,120,*">
                  <TextBlock Classes="mono" Text="{Binding Id}" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Version}" Foreground="{StaticResource MuteBrush}" />
                  <TextBlock Grid.Column="2" Classes="small" Text="{Binding Where}" ToolTip.Tip="{Binding Path}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
