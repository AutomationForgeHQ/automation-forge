<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Forge.Hub.ViewModels.Pages"
             xmlns:vm="using:Forge.Hub.ViewModels"
             x:Class="Forge.Hub.Views.Pages.RunnersPageView"
             x:DataType="p:RunnersPageViewModel">

  <!-- Runners (4.13): what this machine can run. Docker and a rented GPU are outside Unreal, so the Hub can see
       and drive them without an editor open. Content and behaviour as in 0.4.4, on the new tokens. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" DataContext="{Binding Hub}">
    <StackPanel x:DataType="vm:MainViewModel" Spacing="20" Margin="32,36,32,32" MaxWidth="1100" HorizontalAlignment="Left">

      <StackPanel Spacing="8">
        <TextBlock Classes="label amber" Text="RUNNERS" />
        <TextBlock Classes="display-l" Text="What this machine can run" />
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding !HasRunners}">
        <TextBlock Classes="display-xs" Text="Nothing to run" />
        <TextBlock Classes="small" TextWrapping="Wrap" FontSize="14"
                   Text="Nothing installed runs on this machine. MotionForge Kimodo is one that does: a local Docker container, or a GPU rented by the hour." />
        <TextBlock Classes="small" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Only tools installed into an engine appear here. A tool added to a single project is set up inside that project's editor." />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Runners}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RunnerRow">
            <Border Classes="panel" Padding="24,20" Margin="0,0,0,14">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Fill="{StaticResource MuteBrush}" />
                  <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" IsVisible="{Binding IsRunning}" Fill="{StaticResource GoodBrush}" />
                  <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" IsVisible="{Binding NeedsAttention}" Fill="{StaticResource AmberBrush}" />
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Classes="title" Text="{Binding Title}" />
                    <TextBlock Classes="mono" Text="{Binding Plugin}" Foreground="{StaticResource MuteBrush}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="link smalltext" Content="Re-check" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Classes="quiet small" Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" />
                    <Button Classes="primary small" Content="Start" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" MinWidth="84" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Classes="small" Text="Docker" />
                  <TextBlock Grid.Column="1" Classes="body" Text="{Binding DockerLine}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Classes="small" Text="Runner" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" Text="{Binding StateLine}" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Classes="small amber" Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="small" IsVisible="{Binding HasRunners}" TextWrapping="Wrap"
                 Text="The editor can drive the same containers, and either can start or stop one while the other is watching, so both ask Docker rather than trusting what they last did." />

      <StackPanel Spacing="14" IsVisible="{Binding CanRent}" Margin="0,22,0,0">
        <TextBlock Classes="label" Text="A RENTED GPU" />
        <Border IsVisible="{Binding ShowRentInvitation}" Classes="panel" Padding="24,20">
          <StackPanel Spacing="12">
            <TextBlock Classes="body" Text="{Binding RentInvitationLine}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary small" Content="{Binding CloudKeyName, StringFormat='Set the {0} key'}" Command="{Binding ShowKeysCommand}" IsVisible="{Binding !HasCloudKey}" />
              <Button Classes="quiet small" Content="Try again" Command="{Binding RefreshRentedCommand}" IsVisible="{Binding HasCloudKey}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Classes="body" Text="{Binding RentedLine}" TextWrapping="Wrap" IsVisible="{Binding ShowRented}" />
        <ItemsControl ItemsSource="{Binding Rented}" IsVisible="{Binding ShowRented}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RentedRow">
              <Border Classes="panel" Padding="24,20" Margin="0,0,0,10">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Fill="{StaticResource MuteBrush}" />
                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" IsVisible="{Binding IsRunning}" Fill="{StaticResource GoodBrush}" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Classes="title" Text="{Binding Title}" />
                      <TextBlock Classes="small" Text="{Binding StateLine}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="quiet small" Content="Start" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" />
                      <Button Classes="quiet small" Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}" />
                      <Button Classes="primary small" Content="Release" Command="{Binding ReleaseCommand}" MinWidth="86" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="small amber" Text="{Binding CostLine}" TextWrapping="Wrap" />
                  <TextBlock Classes="small" Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="small" TextWrapping="Wrap"
                   Text="Renting one is done in the editor, where the card, the region and the price ceiling are chosen against what the model needs. Stopping and releasing need none of that, so they are here." />
        <TextBlock Classes="small" TextWrapping="Wrap" IsVisible="{Binding ShowRentInvitation}"
                   Text="{Binding CloudPluginName, StringFormat='This is here because {0} is installed.'}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
