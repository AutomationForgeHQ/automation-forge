<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Type (spec 11.2). Sentences in Archivo; mono only for labels, chips, versions, ids and paths. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource InkBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BoneBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Regular" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="Foreground" Value="{StaticResource BoneBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
  </Style>

  <!-- The wide cut, Archivo at width 115 (the site's font-display). -->
  <Style Selector="TextBlock.display-xl">
    <Setter Property="FontFamily" Value="{StaticResource WideFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="LineHeight" Value="42" />
    <Setter Property="LetterSpacing" Value="-0.8" />
  </Style>
  <Style Selector="TextBlock.display-l">
    <Setter Property="FontFamily" Value="{StaticResource WideFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="LineHeight" Value="34" />
    <Setter Property="LetterSpacing" Value="-0.64" />
  </Style>
  <Style Selector="TextBlock.display-m">
    <Setter Property="FontFamily" Value="{StaticResource WideFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="LetterSpacing" Value="-0.48" />
  </Style>
  <Style Selector="TextBlock.display-s">
    <Setter Property="FontFamily" Value="{StaticResource WideFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="LetterSpacing" Value="-0.44" />
  </Style>
  <Style Selector="TextBlock.display-xs">
    <Setter Property="FontFamily" Value="{StaticResource WideFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LetterSpacing" Value="-0.34" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.lede">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="Foreground" Value="{StaticResource Bone80Brush}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="21" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.medium">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="14" />
    <Setter Property="LetterSpacing" Value="2.2" />
    <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
  </Style>
  <Style Selector="TextBlock.label.amber">
    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
  </Style>
  <Style Selector="TextBlock.chip">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="LineHeight" Value="12" />
    <Setter Property="LetterSpacing" Value="1.3" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
  </Style>
  <Style Selector="TextBlock.mute">
    <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
  </Style>
  <Style Selector="TextBlock.amber">
    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
  </Style>
  <Style Selector="TextBlock.hot">
    <Setter Property="Foreground" Value="{StaticResource HotBrush}" />
  </Style>
  <Style Selector="TextBlock.good">
    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
  </Style>

  <!-- The drawers and the Runners page keep their old class names; they now read in the new type.
       "stamp" was mono everywhere; it is a secondary sentence, so it is Archivo 13 in mute. -->
  <Style Selector="TextBlock.stamp">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Inputs: radius 10, quiet ring. -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
    <Setter Property="Background" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BoneBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ComboBox.footer">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="RadioButton">
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    <Setter Property="Background" Value="{StaticResource LineBrush}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{StaticResource PlateBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RingSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MaxWidth" Value="420" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{StaticResource PlateBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RingSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource BoneBrush}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</Styles>
