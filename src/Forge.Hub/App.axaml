<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Forge.Hub.App"
             xmlns:local="using:Forge.Hub"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <!-- The website's tokens, verbatim (website/app/globals.css), and its two typefaces, embedded. -->
  <Application.Resources>
    <Color x:Key="Ink">#0a0a0b</Color>
    <Color x:Key="Plate">#131317</Color>
    <Color x:Key="Line">#26262b</Color>
    <Color x:Key="LineStrong">#3a3a42</Color>
    <Color x:Key="Bone">#edede9</Color>
    <Color x:Key="Mute">#8a8a93</Color>
    <Color x:Key="Dim">#7e7e87</Color>
    <Color x:Key="Amber">#e39a2b</Color>
    <Color x:Key="AmberDim">#8a6320</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
    <SolidColorBrush x:Key="PlateBrush" Color="{StaticResource Plate}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrong}" />
    <SolidColorBrush x:Key="BoneBrush" Color="{StaticResource Bone}" />
    <SolidColorBrush x:Key="MuteBrush" Color="{StaticResource Mute}" />
    <SolidColorBrush x:Key="DimBrush" Color="{StaticResource Dim}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource Amber}" />

    <!-- Fluent's accent is ours: radios, checkboxes and selection highlights turn amber. -->
    <Color x:Key="SystemAccentColor">#e39a2b</Color>
    <Color x:Key="SystemAccentColorDark1">#c9862a</Color>
    <Color x:Key="SystemAccentColorDark2">#a86f24</Color>
    <Color x:Key="SystemAccentColorDark3">#8a6320</Color>
    <Color x:Key="SystemAccentColorLight1">#e9ab4d</Color>
    <Color x:Key="SystemAccentColorLight2">#efbd70</Color>
    <Color x:Key="SystemAccentColorLight3">#f5cf94</Color>

    <FontFamily x:Key="DisplayFont">avares://AutomationForgeHub/Assets/Fonts#Archivo</FontFamily>
    <FontFamily x:Key="MonoFont">avares://AutomationForgeHub/Assets/Fonts#IBM Plex Mono</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource InkBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BoneBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    </Style>
    <Style Selector="TextBlock.display">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.4" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="LetterSpacing" Value="1.6" />
      <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
    </Style>
    <Style Selector="TextBlock.stamp">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Buttons: hairline rectangles, mono labels, amber on hover. -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource BoneBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BoneBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AmberBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource BoneBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource BoneBrush}" />
    </Style>
    <Style Selector="Button.link.amber">
      <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    </Style>

    <!-- The avatar button: no chrome of its own, the circle is the whole control. -->
    <Style Selector="Button.avatar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="17" />
    </Style>
    <Style Selector="Button.avatar:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Hover: the ring warms, like every other button's edge. -->
    <Style Selector="Button.avatar:pointerover Ellipse.ring">
      <Setter Property="Stroke" Value="{StaticResource AmberBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.avatar:pointerover Path">
      <Setter Property="Stroke" Value="{StaticResource BoneBrush}" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{StaticResource PlateBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource BoneBrush}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Choices in the settings panel: quiet controls, our type inside them. -->
    <Style Selector="RadioButton">
      <Setter Property="Padding" Value="10,0,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="MinHeight" Value="24" />
    </Style>

    <!-- Caption buttons: 46px targets, quiet until hovered; close warms to red like every Windows app. -->
    <Style Selector="Button.caption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource LineBrush}" />
      <Setter Property="Foreground" Value="{StaticResource BoneBrush}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#c42b1c" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- The set list: quiet rows, an amber edge on the selected one. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource InkBrush}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="{StaticResource PlateBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
      <Setter Property="Foreground" Value="{StaticResource BoneBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
