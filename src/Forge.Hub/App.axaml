<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Forge.Hub.App"
             xmlns:local="using:Forge.Hub"
             xmlns:vm="using:Forge.Hub.ViewModels"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
    <!-- A chip: the site's small pill for price, stage and ownership (spec 9.1, 11.3). -->
    <DataTemplate DataType="vm:ChipModel">
      <Border Classes="chip" Classes.free="{Binding IsFree}" Classes.paid="{Binding IsPaid}" Classes.stage="{Binding IsStage}"
              Classes.soon="{Binding IsSoon}" Classes.labs="{Binding IsLabs}" Classes.onpicture="{Binding OnPicture}">
        <TextBlock Classes="chip" Text="{Binding Text}" />
      </Border>
    </DataTemplate>
  </Application.DataTemplates>

  <!-- Kovati's tokens, from the site (v2/app/globals.css) as the spec writes them for Avalonia (section 11). -->
  <Application.Resources>
    <Color x:Key="Ink">#08090A</Color>
    <Color x:Key="Plate">#141619</Color>
    <Color x:Key="Line">#25282D</Color>
    <Color x:Key="LineStrong">#3A4049</Color>
    <Color x:Key="Bone">#F1F0EC</Color>
    <Color x:Key="Mute">#9098A5</Color>
    <Color x:Key="Dim">#78859A</Color>
    <Color x:Key="Amber">#EBAA28</Color>
    <Color x:Key="Hot">#FFC44D</Color>
    <Color x:Key="Steel">#667486</Color>
    <Color x:Key="Good">#4CC76F</Color>
    <Color x:Key="Bad">#C42B1C</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
    <SolidColorBrush x:Key="PlateBrush" Color="{StaticResource Plate}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrong}" />
    <SolidColorBrush x:Key="BoneBrush" Color="{StaticResource Bone}" />
    <SolidColorBrush x:Key="MuteBrush" Color="{StaticResource Mute}" />
    <SolidColorBrush x:Key="DimBrush" Color="{StaticResource Dim}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource Amber}" />
    <SolidColorBrush x:Key="HotBrush" Color="{StaticResource Hot}" />
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource Good}" />
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource Bad}" />

    <SolidColorBrush x:Key="Bone90Brush" Color="#E6F1F0EC" />
    <SolidColorBrush x:Key="Bone85Brush" Color="#D9F1F0EC" />
    <SolidColorBrush x:Key="Bone80Brush" Color="#CCF1F0EC" />
    <SolidColorBrush x:Key="Bone75Brush" Color="#BFF1F0EC" />
    <SolidColorBrush x:Key="Bone70Brush" Color="#B3F1F0EC" />
    <SolidColorBrush x:Key="Bone60Brush" Color="#99F1F0EC" />
    <SolidColorBrush x:Key="Bone50Brush" Color="#80F1F0EC" />

    <SolidColorBrush x:Key="RingSoftBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="RingMidBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="RingStrongBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="RingAmberBrush" Color="#73EBAA28" />
    <SolidColorBrush x:Key="ChipDarkBrush" Color="#BF08090A" />
    <SolidColorBrush x:Key="AmberWashBrush" Color="#26EBAA28" />
    <SolidColorBrush x:Key="LabsWashBrush" Color="#1AEBAA28" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#B308090A" />
    <SolidColorBrush x:Key="ScrimDeepBrush" Color="#D908090A" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0DFFFFFF" />

    <!-- Fluent's accent is Kovati's amber: tick boxes, switches, selection. -->
    <Color x:Key="SystemAccentColor">#EBAA28</Color>
    <Color x:Key="SystemAccentColorDark1">#D29721</Color>
    <Color x:Key="SystemAccentColorDark2">#B5811B</Color>
    <Color x:Key="SystemAccentColorDark3">#8A6320</Color>
    <Color x:Key="SystemAccentColorLight1">#F3B93A</Color>
    <Color x:Key="SystemAccentColorLight2">#FFC44D</Color>
    <Color x:Key="SystemAccentColorLight3">#FFC44D</Color>

    <!-- Static cuts of Archivo (slice 0: Avalonia does not move a variable font's axes). -->
    <FontFamily x:Key="DisplayFont">avares://AutomationForgeHub/Assets/Fonts#Archivo</FontFamily>
    <FontFamily x:Key="WideFont">avares://AutomationForgeHub/Assets/Fonts#Archivo Display</FontFamily>
    <FontFamily x:Key="MonoFont">avares://AutomationForgeHub/Assets/Fonts#IBM Plex Mono</FontFamily>

    <!-- The Kovati mark, the drawing of account/components/KovatiMark.tsx on a 100 x 100 grid. -->
    <StreamGeometry x:Key="MarkRing">M45.16 84.41 A34.75 34.75 0 1 1 54.84 84.41</StreamGeometry>
    <StreamGeometry x:Key="MarkBone">M43.66 14.05 L56.34 14.05 L55.8 5.37 L44.2 5.37 Z M82.23 32.86 L86.14 44.92 L94.23 41.72 L90.65 30.7 Z M76.26 75.36 L66 82.81 L71.54 89.51 L80.92 82.7 Z M34 82.81 L23.74 75.36 L19.08 82.7 L28.46 89.51 Z M13.86 44.92 L17.77 32.86 L9.35 30.7 L5.77 41.72 Z M54.38 81.19 L55.29 87.63 L59.45 87.05 L58.54 80.61 Z M45.62 81.19 L44.71 87.63 L40.55 87.05 L41.46 80.61 Z M22 58.2 L32 53.5 L70 53.5 L70 59 L60 59 L56.5 65 L59.5 70.5 L59.5 76 L40.5 76 L40.5 70.5 L43.5 65 L40 59 L32 59 Z M35.62 41.48 L45.99 34.49 L54.38 46.92 L44.01 53.91 Z M47.44 41.36 L68.99 26.82 L71.56 30.64 L50.01 45.18 Z</StreamGeometry>
    <StreamGeometry x:Key="MarkAmber">M42 50.93 L52.36 43.94 L54.38 46.92 L44.01 53.91 Z M38.2 51.0 L26.5 44.5 L28.6 49.2 Z M38.2 51.0 L25.0 51.4 L28.0 54.0 Z M38.2 51.0 L29.5 58.0 L33.2 56.2 Z</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AutomationForgeHub/Styles/Type.axaml" />
    <StyleInclude Source="avares://AutomationForgeHub/Styles/Buttons.axaml" />
    <StyleInclude Source="avares://AutomationForgeHub/Styles/Cards.axaml" />
  </Application.Styles>
</Application>
