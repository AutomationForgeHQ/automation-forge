<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders the 0.4.x Hub's main window to PNG with Avalonia's headless platform and Skia (as Kovati Hub's
    tests/Forge.Hub.Snapshots does): no desktop capture, no real window, no tray, no single-instance lock, nothing
    sent to other programs, every network address a closed local port, and a scratch data folder per scenario.

        dotnet run -project tests/Forge.Hub.Snapshots - <out dir> [<scratch dir>] [name filter...]
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Licences signed with a throwaway key made at run time (a Debug build of Forge.Core reads FORGE_LICENCE_DEV_KEYS). -->
    <Compile Include="..\Shared\LicenceSigning.cs" Link="Shared\LicenceSigning.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Forge.Hub\Forge.Hub.csproj" />
  </ItemGroup>

</Project>
