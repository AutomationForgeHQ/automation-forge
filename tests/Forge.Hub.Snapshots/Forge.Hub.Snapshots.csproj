<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders the Hub's own windows to PNG with Avalonia's headless platform and Skia: no desktop capture,
    no real window, nothing sent to other programs. Run: dotnet run -project tests/Forge.Hub.Snapshots - <out dir> [slice0|screens]
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Licence screens sign with a throwaway key made at run time (tests/Shared). -->
    <Compile Include="..\Shared\LicenceSigning.cs" Link="Shared\LicenceSigning.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Forge.Hub\Forge.Hub.csproj" />
  </ItemGroup>

</Project>
